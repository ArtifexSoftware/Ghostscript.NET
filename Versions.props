<Project>
  <PropertyGroup>
    <!-- Ghostscript.NET NuGet package version -->
    <GhostscriptNetVersion>1.3.6</GhostscriptNetVersion>

    <!-- Ghostscript.NativeAssets NuGet package version (tracks Ghostscript 10.08.0; NuGet drops the leading zero) -->
    <GhostscriptNativeAssetsVersion>10.8.0</GhostscriptNativeAssetsVersion>

    <!-- Ghostscript product version shipped in NativeAssets (for docs/descriptions) -->
    <GhostscriptProductVersion>10.08.0</GhostscriptProductVersion>
  </PropertyGroup>
</Project>
