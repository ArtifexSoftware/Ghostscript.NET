<Project>
  <PropertyGroup>
    <!-- Ghostscript.NET NuGet package version -->
    <GhostscriptNetVersion>1.3.4</GhostscriptNetVersion>

    <!-- Ghostscript.NativeAssets NuGet package version (tracks Ghostscript release) -->
    <GhostscriptNativeAssetsVersion>10.7.1</GhostscriptNativeAssetsVersion>

    <!-- Ghostscript product version shipped in NativeAssets (for docs/descriptions) -->
    <GhostscriptProductVersion>10.07.1</GhostscriptProductVersion>
  </PropertyGroup>
</Project>
